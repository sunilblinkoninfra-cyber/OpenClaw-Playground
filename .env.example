# Environment Configuration Template
# Copy to .env in the root, backend, and frontend directories

# Global
ENVIRONMENT=development
APP_NAME=Openclaw

# Backend Services
DATABASE_URL=postgresql://postgres:password@localhost:5432/openclaw
REDIS_URL=redis://localhost:6379

# Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SECRET_KEY=your-super-secret-key-change-this-in-production

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloud Provider (AWS)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Docker Registry
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_registry_username
DOCKER_PASSWORD=your_registry_password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_pub_key

# Features
ENABLE_PHONE_VERIFICATION=true
ENABLE_TRIAL_REQUIRED=true
TRIAL_DURATION_HOURS=24
